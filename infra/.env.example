# Root orchestration only. Service credentials remain in each repository's .env.
NEOVIDS_NETWORK=neovids

# Must remain outside every NeoVids Git repository and Docker volume.
NEOVIDS_BACKUP_ROOT=/home/bernardo/backups/neovids

# Shared model gateway. Keep the API key in the local environment, never Git.
NINEROUTER_COMPOSE_DIR=/home/bernardo/services/9router
NINEROUTER_HOST_BASE_URL=http://127.0.0.1:20128
NINEROUTER_API_KEY=
NINEROUTER_REQUIRED_CHAT_ROUTES=neovids-fast,neovids-standard,neovids-strong,neovids-vision
NINEROUTER_EMBEDDING_MODEL=neovids-embedding

# Host endpoints documented for tooling/operators.
IDEAS_HUB_API_URL=http://127.0.0.1:8000
MEDIA_INDEXER_API_URL=http://127.0.0.1:8012
QWEN_VOICE_API_URL=http://127.0.0.1:8889
VIDEO_COMPOSER_API_URL=http://127.0.0.1:8013
ORCHESTRATOR_API_URL=http://127.0.0.1:8011
