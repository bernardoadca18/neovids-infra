#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
INFRA_REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd -P)"
ROOT_DIR="${NEOVIDS_WORKSPACE_ROOT:-$(cd "$INFRA_REPO_DIR/.." && pwd -P)}"
NETWORK_NAME="${NEOVIDS_NETWORK:-neovids}"
BACKUP_ROOT="${NEOVIDS_BACKUP_ROOT:-$HOME/backups/neovids}"
NINEROUTER_COMPOSE_DIR="${NINEROUTER_COMPOSE_DIR:-$HOME/services/9router}"
NINEROUTER_HOST_BASE_URL="${NINEROUTER_HOST_BASE_URL:-http://127.0.0.1:20128}"
OLLAMA_HOST_BASE_URL="${OLLAMA_HOST_BASE_URL:-http://127.0.0.1:11434}"
OLLAMA_EMBEDDING_MODEL="${OLLAMA_EMBEDDING_MODEL:-mxbai-embed-large:latest}"

usage() {
  cat <<'EOF'
Usage: ./scripts/neovids <command> [service|option]

Commands:
  doctor                 Safe, read-only host and dependency diagnostics
  up [--build]           Start the stack; optionally rebuild all images first
  down                   Remove only NeoVids containers; preserve all data
  restart [service]      Restart the stack or one application group
  status [service]       Show Compose status
  resources [options]    Read-only host/container/GPU/disk resource snapshot
  health                 Check host endpoints and external dependencies
  logs [service]         Show the latest service logs
  build                  Build application images using existing lockfiles

Service groups: 9router, ideas-hub, media-indexer, qwen, video-composer, orchestrator

Resource options: --json, --watch [seconds]
EOF
}

router_compose() {
  [[ -f "$NINEROUTER_COMPOSE_DIR/compose.yml" ]] || {
    printf '9Router compose file is unavailable: %s/compose.yml\n' "$NINEROUTER_COMPOSE_DIR" >&2
    return 1
  }
  (
    cd "$NINEROUTER_COMPOSE_DIR"
    docker compose "$@"
  )
}

load_ninerouter_api_key() {
  [[ -n "${NINEROUTER_API_KEY:-}" ]] && return
  local env_file line
  for env_file in "$ROOT_DIR/ideas-hub/.env" "$ROOT_DIR/media-indexer/.env"; do
    [[ -r "$env_file" ]] || continue
    line="$(grep -m1 '^NINEROUTER_API_KEY=' "$env_file" || true)"
    if [[ -n "${line#NINEROUTER_API_KEY=}" ]]; then
      NINEROUTER_API_KEY="${line#NINEROUTER_API_KEY=}"
      export NINEROUTER_API_KEY
      return
    fi
  done
}

compose() {
  local group="$1"
  shift
  local repo project base override
  case "$group" in
    ideas-hub)
      repo="ideas-hub"
      project="ideas-hub"
      base="docker-compose.yml"
      override="ideas-hub.yml"
      ;;
    media-indexer)
      repo="media-indexer"
      project="media-indexer"
      base="docker-compose.yml"
      override="media-indexer.yml"
      ;;
    orchestrator)
      repo="orchestrator"
      project="orchestrator"
      base="docker-compose.yml"
      override="orchestrator.yml"
      ;;
    qwen)
      repo="qwen3-tts-workshop"
      project="qwen3-tts-workshop"
      base="docker-compose.yaml"
      override="qwen3-tts-workshop.yml"
      ;;
    video-composer)
      repo="video-composer"
      project="video-composer"
      base="docker-compose.yml"
      override="video-composer.yml"
      ;;
    *)
      printf 'Unknown service group: %s\n' "$group" >&2
      return 2
      ;;
  esac
  (
    cd "$ROOT_DIR/$repo"
    NEOVIDS_NETWORK="$NETWORK_NAME" docker compose \
      --project-name "$project" \
      --file "$base" \
      --file "$INFRA_REPO_DIR/infra/orchestration/$override" \
      "$@"
  )
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'Required command is unavailable: %s\n' "$1" >&2
    return 1
  }
}

require_docker() {
  require_command docker
  docker info >/dev/null 2>&1 || {
    printf 'Docker daemon is unavailable.\n' >&2
    return 1
  }
}

required_volumes() {
  printf '%s\n' \
    ideas-hub-db-data \
    media-indexer_media-indexer-db-data \
    media-indexer_media-indexer-model-cache \
    orchestrator-db-data \
    video-composer_video-composer-data
}

verify_volume_identity() {
  local missing=0 volume
  while IFS= read -r volume; do
    if docker volume inspect "$volume" >/dev/null 2>&1; then
      printf 'volume %-52s OK\n' "$volume"
    else
      printf 'volume %-52s MISSING\n' "$volume" >&2
      missing=1
    fi
  done < <(required_volumes)
  if ((missing)); then
    printf 'Refusing startup: an established durable volume is missing.\n' >&2
    return 1
  fi
}

detect_installation_mode() {
  local present=0 total=0 volume
  while IFS= read -r volume; do
    total=$((total + 1))
    if docker volume inspect "$volume" >/dev/null 2>&1; then
      present=$((present + 1))
    fi
  done < <(required_volumes)

  if ((present == total)); then
    INSTALLATION_MODE="existing"
  elif ((present == 0)); then
    INSTALLATION_MODE="fresh"
  else
    INSTALLATION_MODE="partial"
  fi
}

prepare_installation() {
  detect_installation_mode
  case "$INSTALLATION_MODE" in
    existing)
      printf 'installation %-47s EXISTING\n' "NeoVids durable state"
      verify_volume_identity
      verify_bind_mounts
      ;;
    fresh)
      printf 'installation %-47s FRESH\n' "NeoVids durable state"
      printf 'Compose will create the five canonical named volumes.\n'
      initialize_fresh_bind_mounts
      ;;
    partial)
      printf 'installation %-47s PARTIAL / AMBIGUOUS\n' "NeoVids durable state" >&2
      verify_volume_identity || true
      printf 'Refusing startup: restore the missing established volumes or remove ambiguity manually.\n' >&2
      return 1
      ;;
  esac
}

initialize_fresh_bind_mounts() {
  local paths=(
    "$ROOT_DIR/media-indexer/storage"
    "$ROOT_DIR/orchestrator/data/audio"
    "$ROOT_DIR/orchestrator/cache/huggingface"
    "$ROOT_DIR/qwen3-tts-workshop/cache/huggingface"
    "$ROOT_DIR/qwen3-tts-workshop/data/jobs"
    "$ROOT_DIR/qwen3-tts-workshop/data/outputs"
  )
  local path
  for path in "${paths[@]}"; do
    mkdir -p "$path"
  done
  verify_bind_mounts
}

verify_bind_mounts() {
  local missing=0 path
  local paths=(
    "$ROOT_DIR/media-indexer/storage"
    "$ROOT_DIR/orchestrator/data/audio"
    "$ROOT_DIR/orchestrator/cache/huggingface"
    "$ROOT_DIR/qwen3-tts-workshop/cache/huggingface"
    "$ROOT_DIR/qwen3-tts-workshop/data/references"
    "$ROOT_DIR/qwen3-tts-workshop/data/jobs"
    "$ROOT_DIR/qwen3-tts-workshop/data/outputs"
  )
  for path in "${paths[@]}"; do
    if [[ -d "$path" ]]; then
      printf 'bind   %-52s OK\n' "${path#"$ROOT_DIR/"}"
    else
      printf 'bind   %-52s MISSING\n' "${path#"$ROOT_DIR/"}" >&2
      missing=1
    fi
  done
  return "$missing"
}

ensure_network() {
  if docker network inspect "$NETWORK_NAME" >/dev/null 2>&1; then
    local driver
    driver="$(docker network inspect "$NETWORK_NAME" --format '{{.Driver}}')"
    [[ "$driver" == "bridge" ]] || {
      printf 'Existing network %s uses unexpected driver %s.\n' "$NETWORK_NAME" "$driver" >&2
      return 1
    }
    return
  fi
  docker network create \
    --driver bridge \
    --label com.neovids.managed=true \
    "$NETWORK_NAME" >/dev/null
  printf 'Created shared application network: %s\n' "$NETWORK_NAME"
}

container_id() {
  compose "$1" ps --quiet "$2"
}

validate_qwen_topology() {
  local container topology
  container="$(container_id qwen qwen-tts)"
  if [[ -z "$container" ]]; then
    printf 'Qwen topology validation failed: qwen-tts container is absent.\n' >&2
    return 1
  fi
  topology="$(docker inspect --format '{{json .NetworkSettings.Networks}}' "$container")"
  if [[ "$topology" != *\"$NETWORK_NAME\":* ]]; then
    printf 'Qwen topology validation failed: network %s is absent.\n' "$NETWORK_NAME" >&2
    return 1
  fi
  if [[ "$topology" != *\"qwen-voice\"* ]]; then
    printf 'Qwen topology validation failed: alias qwen-voice is absent.\n' >&2
    return 1
  fi
  printf '%-24s READY (network=%s alias=qwen-voice)\n' "Qwen topology" "$NETWORK_NAME"
}

wait_container_health() {
  local label="$1" container="$2" timeout="$3"
  local deadline=$((SECONDS + timeout)) state
  while ((SECONDS < deadline)); do
    state="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container" 2>/dev/null || true)"
    if [[ "$state" == "healthy" || "$state" == "running" ]]; then
      printf '%-24s READY\n' "$label"
      return
    fi
    if [[ "$state" == "unhealthy" || "$state" == "exited" || "$state" == "dead" ]]; then
      printf '%s failed with container state %s.\n' "$label" "$state" >&2
      docker logs --tail 60 "$container" >&2 || true
      return 1
    fi
    sleep 1
  done
  printf '%s did not become healthy within %ss.\n' "$label" "$timeout" >&2
  docker logs --tail 60 "$container" >&2 || true
  return 1
}

wait_http() {
  local label="$1" url="$2" timeout="$3"
  local deadline=$((SECONDS + timeout))
  while ((SECONDS < deadline)); do
    if curl --fail --silent --show-error --max-time 5 "$url" >/dev/null 2>&1; then
      printf '%-24s READY\n' "$label"
      return
    fi
    sleep 2
  done
  printf '%s did not become ready at %s within %ss.\n' "$label" "$url" "$timeout" >&2
  return 1
}

database_count() {
  local container="$1" table="$2"
  docker exec "$container" sh -ceu \
    'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc "$1"' \
    sh "select count(1) from $table"
}

verify_database_contents() {
  local ideas_db media_db orchestrator_db
  ideas_db="$(container_id ideas-hub db)"
  media_db="$(container_id media-indexer db)"
  orchestrator_db="$(container_id orchestrator db)"
  [[ -n "$ideas_db" && -n "$media_db" && -n "$orchestrator_db" ]]

  printf 'Ideas Hub ideias=%s\n' "$(database_count "$ideas_db" ideias)"
  printf 'Media Indexer sessions=%s\n' "$(database_count "$media_db" media_sessions)"
  printf 'Orchestrator workflows=%s\n' "$(database_count "$orchestrator_db" workflow_execucoes)"
}

backup_databases() {
  local destination timestamp ideas_db media_db orchestrator_db
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  destination="$BACKUP_ROOT/$timestamp"
  umask 077
  mkdir -p "$destination"
  ideas_db="$(container_id ideas-hub db)"
  media_db="$(container_id media-indexer db)"
  orchestrator_db="$(container_id orchestrator db)"
  docker exec "$ideas_db" sh -ceu \
    'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' \
    >"$destination/ideas-hub.dump"
  docker exec "$media_db" sh -ceu \
    'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' \
    >"$destination/media-indexer.dump"
  docker exec "$orchestrator_db" sh -ceu \
    'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' \
    >"$destination/orchestrator.dump"
  printf 'Database backups: %s\n' "$destination"
}

migration_is_current() {
  local group="$1" service="$2" output
  if ! output="$(compose "$group" run --rm --no-deps "$service" \
    env PYTHONPATH=/app alembic current 2>&1)"; then
    printf 'Unable to inspect %s migration state:\n%s\n' "$group" "$output" >&2
    return 2
  fi
  grep -q '(head)' <<<"$output"
}

detect_pending_migrations() {
  PENDING_MIGRATIONS=()
  local status
  if migration_is_current ideas-hub backend; then
    printf 'migration %-50s CURRENT\n' "ideas-hub"
  else
    status=$?
    ((status == 1)) || return "$status"
    PENDING_MIGRATIONS+=("ideas-hub:backend")
    printf 'migration %-50s PENDING\n' "ideas-hub"
  fi
  if migration_is_current media-indexer api; then
    printf 'migration %-50s CURRENT\n' "media-indexer"
  else
    status=$?
    ((status == 1)) || return "$status"
    PENDING_MIGRATIONS+=("media-indexer:api")
    printf 'migration %-50s PENDING\n' "media-indexer"
  fi
  if migration_is_current orchestrator api; then
    printf 'migration %-50s CURRENT\n' "orchestrator"
  else
    status=$?
    ((status == 1)) || return "$status"
    PENDING_MIGRATIONS+=("orchestrator:api")
    printf 'migration %-50s PENDING\n' "orchestrator"
  fi
}

image_missing() {
  ! docker image inspect "$1" >/dev/null 2>&1
}

build_missing_images() {
  if image_missing neovids-ideas-hub-backend:local || \
    image_missing neovids-ideas-hub-frontend:local; then
    compose ideas-hub build backend frontend
  fi
  if image_missing neovids-media-indexer:local; then
    compose media-indexer build api
  fi
  if image_missing neovids-qwen-voice:local; then
    compose qwen build qwen-tts
  fi
  if image_missing neovids-video-composer:stage16; then
    compose video-composer build video-composer
  fi
  if image_missing neovids-orchestrator-backend:local || \
    image_missing neovids-orchestrator-frontend:local; then
    compose orchestrator build api frontend
  fi
}

build_all() {
  require_docker
  ensure_network
  compose ideas-hub build backend frontend
  compose media-indexer build api
  compose qwen build qwen-tts
  compose video-composer build video-composer
  compose orchestrator build api frontend
}

run_pending_migrations() {
  local entry group service
  for entry in "${PENDING_MIGRATIONS[@]}"; do
    group="${entry%%:*}"
    service="${entry##*:}"
    compose "$group" run --rm --no-deps "$service" \
      env PYTHONPATH=/app alembic upgrade head
  done
}

up_stack() {
  local option="${1:-}"
  if [[ -n "$option" && "$option" != "--build" ]]; then
    printf 'Unknown up option: %s\n' "$option" >&2
    return 2
  fi
  require_docker
  require_command curl
  prepare_installation
  ensure_network
  start_model_gateway

  compose ideas-hub up --detach db
  compose media-indexer up --detach db
  compose orchestrator up --detach db redis
  wait_container_health "Ideas Hub PostgreSQL" "$(container_id ideas-hub db)" 90
  wait_container_health "Media PostgreSQL" "$(container_id media-indexer db)" 90
  wait_container_health "Orchestrator PostgreSQL" "$(container_id orchestrator db)" 90
  wait_container_health "Orchestrator Redis" "$(container_id orchestrator redis)" 60
  if [[ "$INSTALLATION_MODE" == "existing" ]]; then
    verify_database_contents
  fi

  if [[ "$option" == "--build" ]]; then
    build_all
  else
    build_missing_images
  fi

  if [[ "$INSTALLATION_MODE" == "fresh" ]]; then
    PENDING_MIGRATIONS=("ideas-hub:backend" "media-indexer:api" "orchestrator:api")
    printf 'Fresh installation: initializing database schemas without backup.\n'
  else
    detect_pending_migrations
    if ((${#PENDING_MIGRATIONS[@]})); then
      backup_databases
    else
      printf 'No pending migrations; database backup and migration steps skipped.\n'
    fi
  fi
  run_pending_migrations

  compose ideas-hub up --detach --no-build backend frontend
  wait_http "Ideas Hub API" "http://127.0.0.1:8000/health/ready" 120
  wait_http "Ideas Hub frontend" "http://127.0.0.1:5173" 120

  compose media-indexer up --detach --no-build api
  wait_http "Media Indexer" "http://127.0.0.1:8012/health/ready" 180

  compose qwen up --detach --no-build qwen-tts
  validate_qwen_topology
  wait_http "Qwen liveness" "http://127.0.0.1:8889/health/live" 180
  wait_http "Qwen readiness" "http://127.0.0.1:8889/health/ready" 900

  compose video-composer up --detach --no-build video-composer
  wait_http "Video Composer" "http://127.0.0.1:8013/health/ready" 300

  compose orchestrator up --detach --no-build api worker frontend
  wait_http "Orchestrator API" "http://127.0.0.1:8011/health/live" 180
  wait_container_health "Orchestrator worker" "$(container_id orchestrator worker)" 180
  wait_http "Orchestrator frontend" "http://127.0.0.1:5174" 180
  wait_http "Orchestrator readiness" "http://127.0.0.1:8011/health/ready" 120

  health_stack
  status_stack
}

down_stack() {
  require_docker
  compose orchestrator down --remove-orphans
  compose video-composer down --remove-orphans
  compose qwen down --remove-orphans
  compose media-indexer down --remove-orphans
  compose ideas-hub down --remove-orphans
  printf 'NeoVids application containers stopped and removed. Persistent volumes were preserved.\n'
  printf '9Router and Headroom remain running as the shared model gateway boundary.\n'
}

status_group() {
  printf '\n[%s]\n' "$1"
  if [[ "$1" == "9router" ]]; then
    router_compose ps
    return
  fi
  compose "$1" ps
}

status_stack() {
  local selected="${1:-}"
  if [[ -n "$selected" ]]; then
    status_group "$selected"
    return
  fi
  status_group 9router
  status_group ideas-hub
  status_group media-indexer
  status_group qwen
  status_group video-composer
  status_group orchestrator
}

resources_stack() {
  require_command python3
  python3 "$INFRA_REPO_DIR/scripts/neovids_resources.py" \
    --workspace-root "$ROOT_DIR" "$@"
}

check_url() {
  local label="$1" url="$2" required="${3:-true}"
  local result
  result="$(curl --silent --show-error --output /dev/null \
    --write-out '%{http_code} %{time_total}' --max-time 8 "$url" 2>/dev/null || true)"
  if [[ "$result" == 2* ]]; then
    printf '%-24s READY       %s\n' "$label" "$result"
    return
  fi
  printf '%-24s UNAVAILABLE %s\n' "$label" "${result:-connection_failed}"
  [[ "$required" != "true" ]]
}

check_ninerouter_contract() {
  require_command python3
  load_ninerouter_api_key
  if [[ -z "${NINEROUTER_API_KEY:-}" ]]; then
    printf '%-24s UNAVAILABLE missing NINEROUTER_API_KEY\n' "9Router models"
    return 1
  fi
  export NINEROUTER_CHECK_BASE="$NINEROUTER_HOST_BASE_URL"
  export NINEROUTER_REQUIRED_CHAT_ROUTES="${NINEROUTER_REQUIRED_CHAT_ROUTES:-neovids-fast,neovids-standard,neovids-strong,neovids-vision}"
  python3 - <<'PY'
import json
import os
import urllib.error
import urllib.request

base = os.environ["NINEROUTER_CHECK_BASE"].rstrip("/")
key = os.environ["NINEROUTER_API_KEY"]
headers = {"Authorization": f"Bearer {key}"}

def model_ids(endpoint: str) -> set[str]:
    request = urllib.request.Request(base + endpoint, headers=headers)
    with urllib.request.urlopen(request, timeout=8) as response:
        payload = json.load(response)
    return {str(item["id"]) for item in payload.get("data", []) if item.get("id")}

try:
    chat_routes = model_ids("/v1/models")
except (urllib.error.URLError, ValueError, KeyError) as exc:
    print(f"{'9Router models':24} UNAVAILABLE {type(exc).__name__}")
    raise SystemExit(1)

required = set(filter(None, os.environ["NINEROUTER_REQUIRED_CHAT_ROUTES"].split(",")))
missing = sorted(required - chat_routes)
if missing:
    print(f"{'9Router models':24} UNAVAILABLE missing={','.join(missing)}")
    raise SystemExit(1)
print(f"{'9Router models':24} READY       routes={','.join(sorted(required))}")
PY
}

check_ollama_contract() {
  require_command python3
  export OLLAMA_CHECK_BASE="$OLLAMA_HOST_BASE_URL"
  export OLLAMA_CHECK_MODEL="$OLLAMA_EMBEDDING_MODEL"
  python3 - <<'PY'
import json
import os
import urllib.error
import urllib.request

base = os.environ["OLLAMA_CHECK_BASE"].rstrip("/")
model = os.environ["OLLAMA_CHECK_MODEL"]
try:
    with urllib.request.urlopen(base + "/api/version", timeout=5) as response:
        version = str(json.load(response).get("version") or "unknown")
    with urllib.request.urlopen(base + "/api/tags", timeout=5) as response:
        payload = json.load(response)
except (urllib.error.URLError, ValueError, KeyError) as exc:
    print(f"{'Ollama embeddings':24} UNAVAILABLE {type(exc).__name__}")
    raise SystemExit(1)

models = {str(item.get("name")) for item in payload.get("models", [])}
if model not in models:
    print(f"{'Ollama embeddings':24} UNAVAILABLE missing_model={model}")
    raise SystemExit(1)
print(f"{'Ollama embeddings':24} READY       version={version} model={model} expected_dimensions=1024")
PY
}

start_model_gateway() {
  router_compose up --detach headroom 9router
  wait_container_health "Headroom" "$(router_compose ps --quiet headroom)" 90
  wait_container_health "9Router" "$(router_compose ps --quiet 9router)" 90
  wait_http "9Router API" "$NINEROUTER_HOST_BASE_URL/api/health" 60
  check_ninerouter_contract
  wait_http "Ollama API" "$OLLAMA_HOST_BASE_URL/api/version" 15
  check_ollama_contract
}

report_port() {
  local port="$1" label="$2"
  if ss --tcp --listening --numeric "sport = :$port" | tail -n +2 | grep -q .; then
    printf 'port %-5s %-30s LISTENING\n' "$port" "$label"
  else
    printf 'port %-5s %-30s FREE\n' "$port" "$label"
  fi
}

health_stack() {
  require_command curl
  local failed=0
  check_url "9Router" "$NINEROUTER_HOST_BASE_URL/api/health" || failed=1
  check_ninerouter_contract || failed=1
  check_ollama_contract || failed=1
  wait_container_health "Headroom" "$(router_compose ps --quiet headroom)" 5 || failed=1
  check_url "Ideas Hub" "http://127.0.0.1:8000/health/ready" || failed=1
  check_url "Media Indexer" "http://127.0.0.1:8012/health/ready" || failed=1
  check_url "Qwen Voice" "http://127.0.0.1:8889/health/ready" || failed=1
  validate_qwen_topology || failed=1
  check_url "Video Composer" "http://127.0.0.1:8013/health/ready" || failed=1
  check_url "Orchestrator" "http://127.0.0.1:8011/health/ready" || failed=1
  check_url "Ideas Hub frontend" "http://127.0.0.1:5173" || failed=1
  check_url "Orchestrator frontend" "http://127.0.0.1:5174" || failed=1
  return "$failed"
}

doctor() {
  local failed=0 current=0 group count
  printf 'NeoVids doctor (read-only)\n'
  require_docker || failed=1
  if ((failed)); then
    return "$failed"
  fi
  detect_installation_mode
  case "$INSTALLATION_MODE" in
    existing)
      printf 'installation %-47s EXISTING\n' "NeoVids durable state"
      verify_volume_identity || failed=1
      verify_bind_mounts || failed=1
      ;;
    fresh)
      printf 'installation %-47s FRESH (bootstrapped by up)\n' "NeoVids durable state"
      ;;
    partial)
      printf 'installation %-47s PARTIAL / AMBIGUOUS\n' "NeoVids durable state" >&2
      verify_volume_identity || true
      failed=1
      ;;
  esac
  if docker network inspect "$NETWORK_NAME" >/dev/null 2>&1; then
    printf 'network %-51s PRESENT\n' "$NETWORK_NAME"
  else
    printf 'network %-51s ABSENT (created by up)\n' "$NETWORK_NAME"
  fi
  printf '\nDisk:\n'
  df -h "$ROOT_DIR" | tail -n 1
  printf '\nMemory:\n'
  free -h | sed -n '1,3p'
  printf '\nGPU:\n'
  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=name,memory.total,memory.used,utilization.gpu \
      --format=csv,noheader,nounits || failed=1
  else
    printf 'nvidia-smi unavailable\n'
    failed=1
  fi
  printf '\nModel gateway boundary:\n'
  check_url "9Router" "$NINEROUTER_HOST_BASE_URL/api/health" || failed=1
  check_ninerouter_contract || failed=1
  check_ollama_contract || failed=1
  wait_container_health "Headroom" "$(router_compose ps --quiet headroom)" 5 || failed=1
  printf '\nHost ports:\n'
  report_port 20128 "9Router"
  report_port 11434 "Ollama embeddings"
  report_port 8000 "Ideas Hub API"
  report_port 5173 "Ideas Hub frontend"
  report_port 5432 "Ideas Hub PostgreSQL"
  report_port 8012 "Media Indexer API"
  report_port 5435 "Media Indexer PostgreSQL"
  report_port 8889 "Qwen Voice"
  report_port 8013 "Video Composer"
  report_port 8011 "Orchestrator API"
  report_port 5174 "Orchestrator frontend"
  report_port 5434 "Orchestrator PostgreSQL"
  report_port 6380 "Orchestrator Redis"
  printf '\nApplication endpoints (informational before up):\n'
  check_url "Ideas Hub" "http://127.0.0.1:8000/health/live" false || true
  check_url "Media Indexer" "http://127.0.0.1:8012/health/live" false || true
  check_url "Qwen Voice" "http://127.0.0.1:8889/health/live" false || true
  check_url "Video Composer" "http://127.0.0.1:8013/health/live" false || true
  check_url "Orchestrator" "http://127.0.0.1:8011/health/live" false || true
  for group in ideas-hub media-indexer orchestrator qwen3-tts-workshop video-composer; do
    count="$(docker ps --all --filter "label=com.docker.compose.project=$group" --quiet | wc -l)"
    current=$((current + count))
  done
  printf '\nNeoVids containers currently present: %s\n' "$current"
  return "$failed"
}

logs_group() {
  if [[ "$1" == "9router" ]]; then
    router_compose logs --tail 200
    return
  fi
  compose "$1" logs --tail 200
}

logs_stack() {
  local selected="${1:-}"
  if [[ -n "$selected" ]]; then
    logs_group "$selected"
    return
  fi
  logs_group 9router
  logs_group ideas-hub
  logs_group media-indexer
  logs_group qwen
  logs_group video-composer
  logs_group orchestrator
}

restart_group() {
  case "$1" in
    9router)
      router_compose restart headroom 9router
      wait_container_health "Headroom" "$(router_compose ps --quiet headroom)" 90
      wait_container_health "9Router" "$(router_compose ps --quiet 9router)" 90
      wait_http "9Router API" "$NINEROUTER_HOST_BASE_URL/api/health" 60
      check_ninerouter_contract
      ;;
    ideas-hub)
      compose ideas-hub restart backend frontend
      wait_http "Ideas Hub API" "http://127.0.0.1:8000/health/ready" 120
      wait_http "Ideas Hub frontend" "http://127.0.0.1:5173" 120
      ;;
    media-indexer)
      compose media-indexer restart api
      wait_http "Media Indexer" "http://127.0.0.1:8012/health/ready" 180
      ;;
    qwen)
      compose qwen restart qwen-tts
      validate_qwen_topology
      wait_http "Qwen liveness" "http://127.0.0.1:8889/health/live" 180
      wait_http "Qwen readiness" "http://127.0.0.1:8889/health/ready" 900
      ;;
    video-composer)
      compose video-composer restart video-composer
      wait_http "Video Composer" "http://127.0.0.1:8013/health/ready" 300
      ;;
    orchestrator)
      compose orchestrator restart api worker frontend
      wait_http "Orchestrator API" "http://127.0.0.1:8011/health/live" 180
      wait_container_health "Orchestrator worker" "$(container_id orchestrator worker)" 180
      wait_http "Orchestrator frontend" "http://127.0.0.1:5174" 180
      wait_http "Orchestrator readiness" "http://127.0.0.1:8011/health/ready" 120
      ;;
    *) printf 'Unknown service group: %s\n' "$1" >&2; return 2 ;;
  esac
}

main() {
  local command="${1:-}"
  case "$command" in
    doctor) doctor ;;
    up)
      [[ $# -le 2 ]] || { usage >&2; return 2; }
      up_stack "${2:-}"
      ;;
    down) down_stack ;;
    restart)
      if [[ -n "${2:-}" ]]; then restart_group "$2"; else down_stack; up_stack; fi
      ;;
    status) status_stack "${2:-}" ;;
    resources) resources_stack "${@:2}" ;;
    health) health_stack ;;
    logs) logs_stack "${2:-}" ;;
    build) build_all ;;
    -h|--help|help|"") usage ;;
    *) usage >&2; return 2 ;;
  esac
}

if [[ "${NEOVIDS_LIB_ONLY:-0}" != "1" ]]; then
  main "$@"
fi
